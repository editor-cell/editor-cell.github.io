{
  "name": "app-builder-workspace",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 8080",
    "build": "npm run build:pages",
    "build:pages": "ORBIS_PAGES=1 vite build && node scripts/pages-shell.mjs && node scripts/check-built-site.mjs",
    "preview": "node scripts/site-server.mjs dist/client 8081",
    "typecheck": "tsc --noEmit",
    "test:site": "node --experimental-strip-types --test scripts/*.test.mjs src/lib/front-order.test.ts src/lib/drafts.test.ts src/lib/search.test.ts src/lib/members/members.test.ts supabase/orbis-members.test.mjs scripts/browser/serve.test.mjs",
    "test": "npm run test:site",
    "lint": "eslint .",
    "format": "prettier --write .",
    "visual:update": "node scripts/browser/set-reference.mjs",
    "test:browser": "node scripts/visual.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.168.0",
    "@tanstack/router-plugin": "^1.168.0",
    "@vitejs/plugin-react": "^5.2.0",
    "lightningcss": "^1.28.0",
    "lucide-react": "^0.510.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^8.2.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "playwright": "^1.62.0",
    "prettier": "^3.4.0",
    "sharp": "^0.34.5",
    "typescript-eslint": "^8.56.1",
    "@electric-sql/pglite": "^0.5.4"
  }
}
